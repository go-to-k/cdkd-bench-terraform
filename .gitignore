node_modules/
cdk/cdk.out/
cdk/node_modules/
# terraform: exclude provider binaries (huge) + state (sensitive: account id + resource detail) at ANY depth
**/.terraform/
**/*.tfstate
**/*.tfstate.*
terraform/.build/
# Per-batch harness output. RESULTS.md is the single record of what was
# measured -- these files are intermediate: one file per invocation, while a
# published row is pooled from several invocations, so an individual file
# cannot be mapped back to a table row on its own.
results/*.log
results/*.md
!results/.gitkeep

# unpublished blog handoff spec (kept local)
BLOG_OUTLINE.md
**/.build/
